# ── Supabase ──
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # ⚠️ KEEP SECRET — never expose client-side

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Telegram ──
TELEGRAM_BOT_TOKEN=bot-token-from-BotFather  # ⚠️ KEEP SECRET
TELEGRAM_CHAT_ID=-100...                      # numeric chat/channel id

# ── Session & Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=                  # 64-char hex, ⚠️ KEEP SECRET
APP_PASSCODE=                    # PIN / passcode to unlock the vault
FILE_URL_SIGNING_SECRET=         # 64-char hex, ⚠️ KEEP SECRET
